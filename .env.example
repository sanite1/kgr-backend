# Copy to .env and fill in. See src/config/validateEnv.ts for what is required.

# Core (required)
MONGODB_URI=
JWT_SECRET=

# Core (optional)
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# JWT lifetimes and refresh secret (defaults: 15m access, 7d refresh, JWT_SECRET reused)
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional: caching/rate limits degrade gracefully without it)
REDIS_URL=

# Mail (optional in phase 1: emails are skipped if absent)
# Gmail for testing: host smtp.gmail.com, port 465, SMTP_USER = your address,
# SMTP_PASSWORD = a Google App Password (not your account password).
# Later switch to Zoho by changing these values only.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DOMAIN_NAME=https://www.kgrpartnersltd.com

# Rate limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=300000

# Admin seed (used by npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=KGR
ADMIN_LAST_NAME=Admin

# Contact form notification recipient
CONTACT_NOTIFICATION_EMAIL=info@kgrpartnersltd.com

# Console base URL, used in admin-side emails (welcome, conversion alerts)
CONSOLE_URL=https://admin.kgrpartnersltd.com

# First Bill ID for the receipt sequence (continues the old system's numbering)
RECEIPT_BILL_START=20000

# Part request numbering (first request id)
REQUEST_ID_START=1000

# Repair job numbering (first job id)
REPAIR_ID_START=500

# Conversion request numbering (first request id)
CONVERSION_ID_START=100

# Expenditure numbering (first entry id)
EXPENDITURE_ID_START=1
