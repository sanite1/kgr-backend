<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>Welcome to KGR Partners</title>
  </head>
  <body style="margin:0; padding:0; background:#f5f7fa; font-family:Arial, Helvetica, sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden;">
      Your KGR Partners management account has been created.
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;">
            <tr>
              <td style="background:linear-gradient(135deg, #0FA53A, #0FF338); height:6px; font-size:0; line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:28px 40px 0 40px;">
                <img src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1783950063/kgr-logo-trans_vawoma.png" width="130" alt="KGR Partners" style="display:block;" />
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px 12px 40px;">
                <h1 style="margin:0; font-size:22px; color:#0D1F15;">Welcome aboard, {{name}}</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 40px 0 40px; font-size:15px; line-height:1.7; color:#4C5B51;">
                Your KGR Partners management account has been created with the
                role <strong style="color:#0D1F15;">{{role}}</strong>. Here are
                your sign-in details.
              </td>
            </tr>
            <tr>
              <td style="padding:18px 40px 4px 40px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7FAF7; border:1px solid #E8ECE8; border-radius:10px;">
                  <tr>
                    <td style="padding:14px 18px 6px 18px; font-size:12px; font-weight:bold; letter-spacing:0.5px; color:#7A877E;">EMAIL</td>
                  </tr>
                  <tr>
                    <td style="padding:0 18px 12px 18px; font-size:15px; font-weight:bold; color:#0D1F15;">{{email}}</td>
                  </tr>
                  <tr>
                    <td style="padding:0 18px 6px 18px; font-size:12px; font-weight:bold; letter-spacing:0.5px; color:#7A877E; border-top:1px solid #E8ECE8;">TEMPORARY PASSWORD</td>
                  </tr>
                  <tr>
                    <td style="padding:0 18px 14px 18px; font-size:16px; font-weight:bold; color:#0A7A2C; font-family:'Courier New', monospace;">{{password}}</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:12px 40px 0 40px; font-size:14px; line-height:1.6; color:#4C5B51;">
                For your security, please change this password after your first
                sign-in from Profile settings in the console.
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px 36px 40px;">
                <a href="{{dashboardUrl}}" style="display:inline-block; background:linear-gradient(135deg, #0FA53A, #0FF338); color:#04170C; font-weight:bold; font-size:15px; text-decoration:none; padding:14px 32px; border-radius:8px;">
                  Open the dashboard
                </a>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 40px 32px 40px; border-top:1px solid #E8ECE8; font-size:12px; color:#7A877E;">
                KGR Partners Ltd · No.6 GGSS Road, KTC Layout, Kawo, Kaduna State, Nigeria<br />
                info@kgrpartnersltd.com
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
