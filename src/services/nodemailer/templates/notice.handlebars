<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>{{title}}</title>
  </head>
  <body style="margin:0; padding:0; background:#f5f7fa; font-family:Arial, Helvetica, sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden;">{{intro}}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;">
            <tr>
              <td style="background:linear-gradient(135deg, #0FA53A, #0FF338); height:6px; font-size:0; line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:28px 40px 0 40px;">
                <img src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1783950063/kgr-logo-trans_vawoma.png" width="130" alt="KGR Partners" style="display:block;" />
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px 12px 40px;">
                <h1 style="margin:0; font-size:22px; color:#0D1F15;">{{title}}</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 40px 0 40px; font-size:15px; line-height:1.7; color:#4C5B51;">
                {{#if name}}Hi {{name}},<br /><br />{{/if}}{{intro}}
              </td>
            </tr>
            {{#if rows.length}}
            <tr>
              <td style="padding:18px 40px 0 40px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7FAF7; border:1px solid #E8ECE8; border-radius:10px;">
                  {{#each rows}}
                  <tr>
                    <td style="padding:10px 18px; width:170px; font-size:13px; font-weight:bold; color:#7A877E; {{#unless @first}}border-top:1px solid #E8ECE8;{{/unless}}">{{this.label}}</td>
                    <td style="padding:10px 18px; font-size:14px; font-weight:bold; color:#0D1F15; {{#unless @first}}border-top:1px solid #E8ECE8;{{/unless}}">{{this.value}}</td>
                  </tr>
                  {{/each}}
                </table>
              </td>
            </tr>
            {{/if}}
            {{#if note}}
            <tr>
              <td style="padding:18px 40px 0 40px;">
                <div style="background:#FDF6E3; border:1px solid #EAD9A8; border-radius:10px; padding:14px 18px; font-size:14px; line-height:1.7; color:#0D1F15; white-space:pre-line;">{{note}}</div>
              </td>
            </tr>
            {{/if}}
            {{#if ctaUrl}}
            <tr>
              <td style="padding:26px 40px 8px 40px;">
                <a href="{{ctaUrl}}" style="display:inline-block; background:linear-gradient(135deg, #0FA53A, #0FF338); color:#04170C; font-weight:bold; font-size:15px; text-decoration:none; padding:14px 32px; border-radius:8px;">{{ctaLabel}}</a>
              </td>
            </tr>
            {{/if}}
            <tr>
              <td style="padding:24px 40px 32px 40px; border-top:1px solid #E8ECE8; font-size:12px; color:#7A877E;">
                KGR Partners Ltd · No.6 GGSS Road, KTC Layout, Kawo, Kaduna State, Nigeria<br />
                info@kgrpartnersltd.com
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
