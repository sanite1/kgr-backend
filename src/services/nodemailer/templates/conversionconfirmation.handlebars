<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>Conversion sheet received</title>
  </head>
  <body style="margin:0; padding:0; background:#f5f7fa; font-family:Arial, Helvetica, sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden;">
      Your EV conversion technical sheet has reached our engineers.
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;">
            <tr>
              <td style="background:linear-gradient(135deg, #0FA53A, #0FF338); height:6px; font-size:0; line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:28px 40px 0 40px;">
                <img src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1783950063/kgr-logo-trans_vawoma.png" width="130" alt="KGR Partners" style="display:block;" />
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px 12px 40px;">
                <h1 style="margin:0; font-size:22px; color:#0D1F15;">Thanks, {{name}}. Your sheet is with our engineers.</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 40px 20px 40px; font-size:15px; line-height:1.7; color:#4C5B51;">
                We've received your EV conversion technical information sheet
                and registered it as request <strong style="color:#0D1F15;">#{{requestId}}</strong>.
                Our team reviews every sheet personally and replies within one
                business day, Monday to Saturday. We may ask for photos of the
                vehicle to complete the assessment.
              </td>
            </tr>
            <tr>
              <td style="padding:0 40px 28px 40px; font-size:15px; line-height:1.7; color:#4C5B51;">
                If anything changes about the vehicle in the meantime, just
                reply to this email and quote request #{{requestId}}.
              </td>
            </tr>
            <tr>
              <td style="padding:20px 40px 32px 40px; border-top:1px solid #E8ECE8; font-size:12px; color:#7A877E;">
                KGR Partners Ltd · No.6 GGSS Road, KTC Layout, Kawo, Kaduna State, Nigeria<br />
                info@kgrpartnersltd.com
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
