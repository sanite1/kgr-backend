{
  "name": "kgr-backend",
  "version": "0.1.0",
  "private": true,
  "description": "KGR Partners management system backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "seed:demo": "ts-node src/scripts/seedDemo.ts",
    "seed:conversions": "ts-node src/scripts/seedConversions.ts",
    "seed:fleet": "ts-node src/scripts/seedBatteryFleet.ts",
    "cleanup:payments": "ts-node src/scripts/cleanupPayments.ts",
    "migrate:batteries": "ts-node src/scripts/migrateBatteryStatus.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@vercel/functions": "^3.7.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validation": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "nodemailer": "^6.9.14",
    "nodemailer-express-handlebars": "^6.1.2",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.16",
    "@types/nodemailer-express-handlebars": "^4.0.5",
    "husky": "^8.0.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
